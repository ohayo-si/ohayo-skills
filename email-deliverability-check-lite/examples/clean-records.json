    "192.0.2.10"
  ],
  "mx2.example.com A": [
    "192.0.2.11"
  ],
  "example.com TXT": [
    "v=spf1 include:_spf.google.com ~all",
    "google-site-verification=abc123"
  ],
  "_spf.google.com TXT": [
    "v=spf1 include:_netblocks.google.com include:_netblocks2.google.com ~all"
  ],
  "_netblocks.google.com TXT": [
