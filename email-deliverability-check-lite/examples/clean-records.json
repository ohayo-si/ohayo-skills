  ],
  "_dmarc.example.com TXT": [
    "v=DMARC1; p=quarantine; rua=mailto:dmarc@example.com; adkim=r; aspf=r"
  ],
  "google._domainkey.example.com TXT": [
    "v=DKIM1; k=rsa; "
  ]
